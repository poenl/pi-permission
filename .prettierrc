{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "none",
  "printWidth": 100,
  "htmlWhitespaceSensitivity": "ignore",
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "quoteProps": "as-needed",
  "tabWidth": 2,
  "useTabs": false
}
